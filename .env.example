# krx-signal-verify — 환경변수 이름만 담는다. 값은 절대 커밋하지 않는다.
# 실제 값은 `.env`에 넣는다 (.gitignore 1행에 걸려 있다).
# CI에서는 리포지토리 Secrets로 주입한다.

# ─────────────────────────────────────────────────────────────
# KIS Developers — ⚠ 임시. V12(적중 추적 기준선) 확인 전용
#
# 목적: KIS 국내업종 API가 pykrx `get_index_ohlcv`를 대체할 만한지 호출로 확인한다.
#       pykrx는 이미 3년치 726행을 1회 호출로 준다 (2026-09-01 실측).
#
# SPEC R13은 「v1에 새 외부 키가 필요 없다」고 적어 두었다.
# 확인이 끝나면 이 블록을 지우거나, KIS를 쓰기로 정하고 SPEC R13을 고친다.
# ─────────────────────────────────────────────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
# 실전 | 모의 — 도메인이 갈린다. 비우면 모의로 본다
KIS_ENV=

# ─────────────────────────────────────────────────────────────
# 이하는 SPEC §8이 정한 이 프로젝트의 실제 자격증명 (M0에서 채운다)
# ─────────────────────────────────────────────────────────────

# OpenDART — 공시·재무. 인증키가 URL 쿼리에 실린다.
# 예외 메시지·로그에 URL을 통째로 찍지 않는다 (N10)
DART_API_KEY=

# Claude — 근거 서술 (F11). 없으면 서술 없이 돌고 `⚠ 서술 생략`이 붙는다
ANTHROPIC_API_KEY=

# 네이버 검색 — 뉴스. 아래 두 쌍 중 **한 쌍만** 온전하면 된다
#   ① NCP API HUB (권장)
NCP_APIGW_API_KEY_ID=
NCP_APIGW_API_KEY=
#   ② 개발자센터 (2027-06-30 종료 예정)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Supabase — 상위와 같은 값. service key는 RLS를 우회한다.
# 웹 번들에 절대 넣지 않는다
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DATABASE_URL=

# 웹 대시보드 전용 읽기 롤 (V9) — `ksv_*`에 SELECT만.
# 서버 사이드에서만 쓴다. NEXT_PUBLIC_ 접두어를 붙이지 않는다
# ksv_reader 롤 비밀번호 — `apply_schema.py --set-reader-password`가 이 값으로 건다
KSV_READER_PASSWORD=
KSV_READER_DATABASE_URL=

# Gmail SMTP — 앱 비밀번호이지 계정 비밀번호가 아니다
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# 본인 한 사람. 다른 사람을 넣으면 유사투자자문업 경계를 건드린다 (R1)
RECIPIENTS=

# 전문 페이지 배포 — 배포 보호(SSO)를 끄지 않는다 (V10)
VERCEL_TOKEN=
VERCEL_PROJECT=
