// krx-signal-verify — LangGraph 그래프 (PLAN §1-2)
//
// ⚠ 이 그림의 간선은 `scripts/check_diagram.py`가 `docs/GRAPH.md`(자동 생성)와 대조한다.
//    노드 이름과 간선은 **구현과 정확히 같아야 한다** — 어긋나면 CI가 실패한다 (SPEC N16).
//    렌더: dot -Tpng docs/diagrams/graph.dot -o docs/graph.png

digraph verify {
  rankdir=TB;
  bgcolor="transparent";
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#BFC6D6",
        fontname="Helvetica", fontsize=11, margin="0.18,0.10"];
  edge [color="#8B94AC", fontname="Helvetica", fontsize=9];

  START [shape=circle, label="", width=0.22, fillcolor="#121829", color="#121829"];
  END   [shape=doublecircle, label="", width=0.22, fillcolor="#121829", color="#121829"];

  // 채점 — 게이트와 무관하게 돈다
  subgraph cluster_score {
    label="  되돌아보기 — 게이트와 무관하게 돈다 (M4)";
    fontname="Helvetica"; fontsize=10; fontcolor="#626D8A";
    color="#D3D8E4"; style=rounded;
    fill_outcomes [fillcolor="#FBEAEC", color="#C9283E"];
    aggregate     [fillcolor="#FBEAEC", color="#C9283E"];
  }

  gate  [fillcolor="#FAFBFD"];
  wait  [fillcolor="#FAFBFD"];

  fetch_signals;
  fetch_one;
  judge   [fillcolor="#E6F2EF", color="#0F6E5C", label="judge\n판정·점수·저장"];
  explain [style="rounded,filled,dashed", label="explain\nLLM · 없어도 된다"];
  render;
  send_email;
  record_run [label="record_run\n실패해도 먼저 남긴다"];
  finalize   [label="finalize\n성공/실패를 정하는 유일한 곳"];

  START -> fill_outcomes;
  fill_outcomes -> aggregate;

  aggregate -> gate;
  aggregate -> fetch_signals [label="  collect (온디맨드)", color="#6C4FC4", fontcolor="#6C4FC4"];

  gate -> fetch_signals [label="  collect (ready)", color="#1F63A8", fontcolor="#1F63A8"];
  gate -> wait          [label="  missing · 10회까지", color="#B8860B", fontcolor="#B8860B"];
  gate -> render        [label="  report (stale · timeout)", color="#626D8A", fontcolor="#626D8A"];
  wait -> gate          [label="  사이클", color="#B8860B", fontcolor="#B8860B", constraint=false];

  fetch_signals -> fetch_one [label="  fan-out · Send × N", style=dashed];
  fetch_signals -> judge     [label="  신호 0건 직행", style=dotted, color="#626D8A", fontcolor="#626D8A"];
  fetch_one -> judge         [label="  reducer: evidence += ", style=dashed];

  judge -> explain;
  explain -> render;
  render -> send_email;
  send_email -> record_run;
  record_run -> finalize;
  finalize -> END;
}
