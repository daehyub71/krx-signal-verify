# krx-signal-verify/web — 이름만. 값은 Vercel 환경변수(서버 사이드)와 로컬 .env.local에만.
# **어느 것에도 NEXT_PUBLIC_ 접두어를 붙이지 않는다** — 붙이면 브라우저 번들에 실린다 (V9 · R13).

# 전용 읽기 롤 ksv_reader — 풀러(6543 · transaction) 주소. ksv_* SELECT + ksv_requests INSERT/UPDATE(failed)만
KSV_READER_DATABASE_URL=

# 온디맨드 dispatch (F41 · V8 · R8) — fine-grained PAT · 대상 리포 1개 · Contents write
VERIFY_DISPATCH_TOKEN=
VERIFY_REPO=daehyub71/krx-signal-verify

# 온디맨드 하루 상한 (F42). 비우면 5
ONDEMAND_DAILY_LIMIT=5
